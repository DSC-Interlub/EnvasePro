{
  "name": "CheckoutProgramacao",
  "type": "object",
  "properties": {
    "data_programada": {
      "type": "string",
      "format": "date",
      "description": "Data para qual a programa\u00e7\u00e3o foi criada"
    },
    "total_pedidos": {
      "type": "number",
      "description": "Total de pedidos nesta programa\u00e7\u00e3o"
    },
    "pedidos_concluidos": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de pedidos j\u00e1 conclu\u00eddos"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Andamento",
        "Conclu\u00eddo"
      ],
      "default": "Pendente",
      "description": "Status geral da programa\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais sobre a programa\u00e7\u00e3o"
    }
  },
  "required": [
    "data_programada"
  ]
}