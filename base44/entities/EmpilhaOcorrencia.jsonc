{
  "name": "EmpilhaOcorrencia",
  "type": "object",
  "properties": {
    "programacao_id": {
      "type": "string",
      "description": "FK \u2192 EmpilhaProgramacao.id (opcional)"
    },
    "linha_id": {
      "type": "string",
      "description": "FK \u2192 EmpilhaLinha.id (opcional)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Problema",
        "Amassado",
        "Produto errado",
        "Equipamento",
        "Outro"
      ],
      "description": "Tipo de ocorr\u00eancia"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da ocorr\u00eancia"
    },
    "registrado_por": {
      "type": "string",
      "description": "Nome do operador que registrou"
    },
    "registrado_por_funcao": {
      "type": "string",
      "enum": [
        "Empilhador",
        "Ajudante",
        "L\u00edder"
      ],
      "description": "Fun\u00e7\u00e3o de quem registrou"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da ocorr\u00eancia"
    },
    "hora": {
      "type": "string",
      "description": "Hora da ocorr\u00eancia HH:MM"
    },
    "notificado_lider": {
      "type": "boolean",
      "default": false,
      "description": "Se o l\u00edder foi notificado"
    },
    "resolvido": {
      "type": "boolean",
      "default": false,
      "description": "Se a ocorr\u00eancia foi resolvida"
    },
    "resolucao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o de como foi resolvida"
    }
  },
  "required": [
    "descricao",
    "registrado_por",
    "data",
    "hora"
  ]
}