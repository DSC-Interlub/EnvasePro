{
  "name": "CheckoutItem",
  "type": "object",
  "properties": {
    "programacao_id": {
      "type": "string",
      "description": "ID da programa\u00e7\u00e3o \u00e0 qual este item pertence"
    },
    "numero_pedido": {
      "type": "string",
      "description": "N\u00famero do pedido (ex: PV-20.235)"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data de entrega do pedido"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "operador": {
      "type": "string",
      "description": "Nome do operador que realizou o check-out"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio do check-out"
    },
    "hora_termino": {
      "type": "string",
      "description": "Hor\u00e1rio de t\u00e9rmino do check-out"
    },
    "tempo_total": {
      "type": "string",
      "description": "Tempo total calculado"
    },
    "critico": {
      "type": "boolean",
      "default": false,
      "description": "Se o pedido \u00e9 cr\u00edtico"
    },
    "data_saida": {
      "type": "string",
      "format": "date",
      "description": "Data de sa\u00edda do pedido (para cr\u00edticos)"
    },
    "finalizado_fora_do_prazo": {
      "type": "boolean",
      "default": false,
      "description": "Se o pedido foi finalizado fora do prazo"
    },
    "data_finalizacao_real": {
      "type": "string",
      "format": "date",
      "description": "Data real de finaliza\u00e7\u00e3o (quando atrasado)"
    },
    "motivo_atraso": {
      "type": "string",
      "description": "Motivo do atraso na finaliza\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Andamento",
        "Conclu\u00eddo"
      ],
      "default": "Pendente",
      "description": "Status do item"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o check-out"
    }
  },
  "required": [
    "programacao_id",
    "numero_pedido",
    "cliente"
  ]
}