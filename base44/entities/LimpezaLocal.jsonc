{
  "name": "LimpezaLocal",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do local, ex: Sala de Envase, Galp\u00e3o Principal"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Sala",
        "Galp\u00e3o",
        "Banheiro",
        "\u00c1rea externa",
        "Corredor",
        "Outro"
      ],
      "description": "Tipo do local"
    },
    "descricao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o local"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o local est\u00e1 ativo"
    }
  },
  "required": [
    "nome"
  ]
}