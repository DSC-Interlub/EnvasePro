# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — ENVASEPRO
# Copie este arquivo para .env.local e preencha com os valores do SUPABASE LOCAL.
#
# ATENÇÃO:
#  - NUNCA commite o .env.local no controle de versão (já coberto pelo .gitignore).
#  - NUNCA coloque valores REAIS neste arquivo: ele é versionado.
#  - NUNCA coloque credenciais de PRODUÇÃO no .env.local. A service key de produção
#    vive somente nas variáveis de ambiente da Vercel.
#  - Não existe ambiente de staging: há um único projeto remoto (produção).
#    Todo desenvolvimento e teste roda no Supabase local (`npx supabase start`,
#    que imprime URL e chaves; as portas deste projeto são a faixa 5442x).
# ==============================================================================

# Supabase — URL e Chave Pública (Expostas no bundle do frontend com prefixo VITE_)
# Local: http://127.0.0.1:54421
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mesma URL sem o prefixo VITE_, para os scripts Node. O db-guard checa AMBAS.
SUPABASE_URL=

# Supabase — Chave Administrativa de Servidor (NUNCA expor no frontend; usada apenas em serverless e scripts)
SUPABASE_SERVICE_ROLE_KEY=

# Project ref do alvo. DEIXE VAZIO para o local: o db-guard (scripts/lib/db-guard.js)
# aborta qualquer script de escrita quando isto casa com o ref de produção.
SUPABASE_PROJECT_REF=

# Conexão direta ao Postgres local (psql, dumps). Local: postgresql://postgres:postgres@127.0.0.1:54422/postgres
SUPABASE_DB_URL=

# Domínio Base da Aplicação (URL canônica para e-mails e redirecionamentos)
# Local: http://localhost:5173
APP_BASE_URL=

# Provedor de E-mails Transacionais (Vercel Serverless Function)
RESEND_API_KEY=

# Credenciais Iniciais de Provisionamento (scripts/setup-auth-users.js e supabase/seed.sql)
# Senhas LOCAIS e descartáveis, >= 12 caracteres com complexidade (política do config.toml).
# Nunca reutilize aqui uma senha de conta real.
OPERATOR_INITIAL_PASSWORD=
ADMIN_INITIAL_PASSWORD=
DEV_INITIAL_PASSWORD=

# Credenciais de Testes e Auditoria Automatizada (Playwright e Scripts de Teste)
TEST_ADMIN_EMAIL=pcp-brasil@interlub.com
TEST_ADMIN_PASSWORD=
TEST_OPERATOR_EMAIL=operacoes.equipe@interlub.com
TEST_OPERATOR_PASSWORD=
TEST_TV_EMAIL=tv-fabrica@interlub.com
TEST_TV_PASSWORD=
TEST_SIGNUP_PASSWORD=
